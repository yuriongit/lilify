{
  "name": "lilify",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["packages/*"],
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^6.0.0"
  },
  "scripts": {
    "lint": "bunx --bun @biomejs/biome lint",
    "lint:w": "bunx --bun @biomejs/biome lint --write",
    "format": "bunx --bun @biomejs/biome format",
    "format:w": "bunx --bun @biomejs/biome format --write",
    "check": "bunx --bun @biomejs/biome check",
    "check:w": "bunx --bun @biomejs/biome check --write",
    "test": "bun --filter='./packages/*' run test",
    "type-check": "bun --filter='./packages/*' run type-check",
    "dev": "bun --watch --filter='./packages/*' run dev",
    "dev:api": "bun --filter @app/api run dev",
    "dev:frontend": "bun --filter @app/frontend run dev",
    "build": "bun --filter='./packages/*' run build",
    "build:api": "bun --filter @app/api run build",
    "build:frontend": "bun --filter @app/frontend run build",
    "clean": "rm -rf node_modules packages/*/node_modules",
    "clean:lock": "rm -rf node_modules packages/*/node_modules bun.lock"
  }
}
