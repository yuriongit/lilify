  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/redis": "^4.0.11"
  },
  "peerDependencies": {
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
